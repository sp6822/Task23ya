<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F8F9FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="3"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btn_to_first"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="הוספה"
            android:textSize="12sp"
            android:layout_margin="2dp"
            android:backgroundTint="#03DAC5"
            android:textColor="#000000"/>

        <Button
            android:id="@+id/btn_to_second"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="רשימה"
            android:textSize="12sp"
            android:layout_margin="2dp"
            android:backgroundTint="#6200EE"/>

        <Button
            android:id="@+id/btn_to_fourth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="קרדיטים"
            android:textSize="12sp"
            android:layout_margin="2dp"
            android:backgroundTint="#555555"/>
    </LinearLayout>

    <EditText
        android:id="@+id/et_search_desc"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="חפש לפי תיאור..."
        android:background="@android:drawable/editbox_background"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginBottom="16dp">
        <EditText
            android:id="@+id/et_max_price"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="מחיר מקסימום"
            android:background="@android:drawable/editbox_background"
            android:layout_marginRight="4dp"/>
        <EditText
            android:id="@+id/et_min_price"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="מחיר מינימום"
            android:background="@android:drawable/editbox_background"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_filter"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="סנן תוצאות"
        android:backgroundTint="#018786"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_search_results"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</LinearLayout>